{
  "github": {
    "type": "http",
    "url": "https://api.githubcopilot.com/mcp/",
    "bearer_token_env_var": "GITHUB_PERSONAL_ACCESS_TOKEN"
  },
  "mariadb-economy": {
    "type": "http",
    "url": "http://10.111.71.145:8000/mcp"
  },
  "tasklie": {
    "type": "http",
    "url": "https://app.taskl.ie/api/public/mcp",
    "bearer_token_env_var": "TASKLIE_MCP_TOKEN"
  },
  "infisical": {
    "type": "stdio",
    "command": "python3",
    "args": ["${DOTAGENTS_ROOT}/mcp/infisical.py"]
  },
  "playwright": {
    "type": "stdio",
    "command": "npx",
    "args": ["-y", "@playwright/mcp@latest", "--headless"]
  },
  "keycloak": {
    "type": "stdio",
    "command": "python3",
    "args": ["${DOTAGENTS_ROOT}/mcp/keycloak.py"]
  }
}
